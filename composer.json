{
  "name": "ingenerator/warden-persistence-doctrine",
  "type": "library",
  "description": "Persistence provider for warden using doctrine2",
  "homepage": "https://github.com/ingenerator/warden-persistence-doctrine",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Andrew Coulton",
      "email": "andrew@ingenerator.com",
      "homepage": "https://ingenerator.com"
    },
    {
      "name": "Craig Gosman",
      "email": "craig@ingenerator.com",
      "homepage": "https://ingenerator.com"
    }
  ],
  "require": {
    "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
    "doctrine/orm": "^2.20.14",
    "ingenerator/warden-core": "^2.0",
    "symfony/cache": "^7.3 || ^8.1"
  },
  "conflict": {
    "doctrine/dbal": "<3.0",
    "doctrine/event-manager": "<2.1.1",
    "doctrine/persistence": "<3.4.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://php-packages.ingenerator.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Ingenerator\\Warden\\Persistence\\Doctrine\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  }
}
